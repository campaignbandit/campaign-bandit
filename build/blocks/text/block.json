{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "campaign-bandit/text",
  "title": "Text field",
  "category": "campaign-bandit",
  "icon": "feedback",
  "description": "A text field for a Campaign Bandit form.",
  "textdomain": "campaign-bandit",
  "attributes": {
    "label": {
      "type": "string",
      "default": "Name"
    },
    "placeholder": {
      "type": "string",
      "default": ""
    },
    "required": {
      "type": "boolean",
      "default": false
    },
    "fieldKey": {
      "type": "string",
      "default": "name"
    },
    "hideLabel": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "html": false,
    "reusable": false
  },
  "editorScript": "file:./index.js",
  "parent": [
    "campaign-bandit/form"
  ]
}